# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=tradesphere
POSTGRES_PASSWORD=
POSTGRES_DB=tradesphere

# Full DSN used by SQLAlchemy (psycopg3 driver). Replace USER and PASSWORD.
DATABASE_URL=postgresql+psycopg://tradesphere:PASSWORD@db:5432/tradesphere

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── External API keys ─────────────────────────────────────────────────────────
MESSARI_API_KEY=      # free at https://messari.io/account/api (sign-up required)
COINGECKO_API_KEY=   # optional — only needed if the free tier prompts for one

# ── Binance base URLs (public, no key needed for market data) ─────────────────
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_SPOT_REST=https://api.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com

# ── Universe and intervals ────────────────────────────────────────────────────
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
INTERVALS=4h,1d

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

EXCHANGE=binance_testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
EXECUTION_MODE=TESTNET      # ensures the engine refuses to run on mainnet


LLM_PROVIDER=openai          # or anthropic, cohere, etc.
LLM_API_KEY=YOUR_KEY_HERE